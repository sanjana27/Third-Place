PORT=8080
DEMO_ENABLED=true
MIGRATE_ON_START=true

# Use a real PostgreSQL database. This example is local development only.
DATABASE_URL=postgresql://third_place:replace-me@127.0.0.1:5432/third_place

# For Cloud SQL, omit DATABASE_URL and set these instead.
INSTANCE_CONNECTION_NAME=
DB_NAME=third_place
DB_USER=third_place
DB_PASSWORD=

# Choose GEMINI_MODEL using npm run models and a successful project-access test.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true
GEMINI_MODEL=

# Authentication is server-side only. Never prefix secrets with VITE_.
# GOOGLE_APPLICATION_CREDENTIALS must point to a local, ignored ADC file if needed.
